rn=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#285882;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="req" target="base"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e93" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#285882;strokeWidth=2.4;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#285882;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="base" target="install"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e94" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#A34538;strokeWidth=2.4;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#A34538;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="install" target="den"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l99" style="endArrow=none;endFill=1;startArrow=none;strokeColor=#BDCED1;strokeWidth=1.5;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="925" as="sourcePoint"/><mxPoint x="1555" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v3" value="fCavEX   /   SYSTEM ARCHITECTURE" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#B9DED5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="47" y="15" width="1230" height="28" as="geometry"/></mxCell><mxCell id="v4" value="What happens when players separate" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=40;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="46" y="43" width="1460" height="57" as="geometry"/></mxCell><mxCell id="v5" value="The host simulates the union of active neighborhoods. Each client keeps only its subscription." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontColor=#DDECEB;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="100" width="1500" height="29" as="geometry"/></mxCell><mxCell id="v7" value="ACTIVE COLUMNS  /  SQUARE SUBSCRIPTIONS, r = 2" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="64" y="181" width="693" height="27" as="geometry"/></mxCell><mxCell id="v33" value="Same center  ·  25 columns in the union" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=22;fontColor=#116B65;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="232" y="225" width="512" height="48" as="geometry"/></mxCell><mxCell id="v34" value="Each client subscribes to 25 columns. A simulates each shared column once." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#4C626C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="232" y="277" width="495" height="66" as="geometry"/></mxCell><mxCell id="v86" value="Disjoint  ·  50 columns in the union" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#285882;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="328" y="415" width="423" height="57" as="geometry"/></mxCell><mxCell id="v87" value="A and B still render 25 each. Old mesh, dirty and in-flight columns add temporary pressure." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#4C626C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="328" y="478" width="421" height="90" as="geometry"/></mxCell><mxCell id="v88" value="Each grid cell is one 16 × 16 × 128 column. Center cells mark the players." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="565" width="643" height="48" as="geometry"/></mxCell><mxCell id="v90" value="A05 DATA OWNERSHIP  /  PROPOSED" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="816" y="181" width="719" height="27" as="geometry"/></mxCell><mxCell id="h" value="&lt;div style=&quot;font-size:14px;color:#116B65;font-weight:bold;&quot;&gt;AUTHORITY  /  ColumnKey = (dimension, cx, cz)&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Column record&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Revisions, subscriber references, dirty revision, pins and authoritative block/light arrays. Track active simulation separately from residency.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="830" y="228" width="692" height="113" as="geometry"/></mxCell><mxCell id="s" value="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;REPLICATION  /  Per-player interest&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Stream budget&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Diff subscriptions, prioritize nearer columns fairly between actors, and bound bytes per peer. Skip mesh creation on the authority path.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="830" y="360" width="692" height="114" as="geometry"/></mxCell><mxCell id="r" value="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;CLIENT  /  (ColumnKey, subscription generation)&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Installed base + local mesh&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Allocate only the current view. Discard obsolete fragments on unsubscribe or session restart.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="830" y="492" width="692" height="110" as="geometry"/></mxCell><mxCell id="v91" value="One subscription from first request to a coherent view" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#17313B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="49" y="665" width="1450" height="30" as="geometry"/></mxCell><mxCell id="req" value="Subscribe + generation g" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=17;fontColor=#4C626C;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="49" y="722" width="267" height="72" as="geometry"/></mxCell><mxCell id="base" value="Assemble snapshot (g, R)&lt;br&gt;Check offsets, size and checksum" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#285882;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="379" y="722" width="298" height="72" as="geometry"/></mxCell><mxCell id="install" value="Atomically install R&lt;br&gt;Apply contiguous R+1 …" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=17;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="746" y="722" width="319" height="72" as="geometry"/></mxCell><mxCell id="den" value="Gap / checksum failure / delta overrun&lt;br&gt;Discard partial work; request a fresh base" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FBEDE9;strokeColor=#A34538;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#A34538;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1132" y="722" width="418" height="72" as="geometry"/></mxCell><mxCell id="v95" value="A lighting update can touch the next column. Mark every changed column, then route deltas to the subscribers of each. Evict only when unreferenced, unpinned and safely saved at the same revision." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="815" width="1500" height="48" as="geometry"/></mxCell><object id="v96" label="Fork · radius and streaming" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_local.c#L559-L625" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="876" width="262" height="32" as="geometry"/></mxCell></object><object id="v97" label="Fork · dirty lighting updates" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_world.c#L138-L149" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="330" y="876" width="270" height="32" as="geometry"/></mxCell></object><object id="v98" label="Fork · column byte arrays" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/region_archive.c#L275-L310" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;ro