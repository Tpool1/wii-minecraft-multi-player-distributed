" vertex="1"><mxGeometry x="49" y="854" width="286" height="32" as="geometry"/></mxCell></object><object id="v17" label="Fork · existing edit command fields" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_interface.h#L43-L76" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="355" y="854" width="288" height="32" as="geometry"/></mxCell></object><object id="v18" label="Dolphin 2609b · Wii bind/connect" link="https://github.com/dolphin-emu/dolphin/blob/3a5b3743b18da3e8f04cbc44f20dc50fbd3a9ef3/Source/Core/Core/IOS/Network/Socket.cpp#L288-L335" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="666" y="854" width="282" height="32" as="geometry"/></mxCell></object><mxCell id="v20" value="VIEWS" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="47" y="938" width="85" height="34" as="geometry"/></mxCell><object id="v21" label="System" link="data:page/id,a-overview"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F4F7F7;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;fontColor=#4C626C;fontStyle=0;fontSize=15;spacing=0;" parent="1" vertex="1"><mxGeometry x="146" y="938" width="145" height="36" as="ge