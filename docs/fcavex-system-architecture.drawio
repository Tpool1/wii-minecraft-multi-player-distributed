tFamily=Arial;fontColor=#94561B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="stage" target="check"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#94561B;strokeWidth=2.4;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#94561B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="check" target="mark"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l11" style="endArrow=none;endFill=1;startArrow=none;strokeColor=#BDCED1;strokeWidth=1.5;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="49" y="488" as="sourcePoint"/><mxPoint x="1550" y="488" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#285882;strokeWidth=2.4;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#285882;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="host" target="join"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#285882;strokeWidth=2.4;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#285882;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="peer" target="join"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="278" y="754"/><mxPoint x="1303" y="754"/></Array></mxGeometry></mxCell><mxCell id="l20" style="endArrow=none;endFill=1;startArrow=none;strokeColor=#BDCED1;strokeWidth=1.5;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="925" as="sourcePoint"/><mxPoint x="1555" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v3" value="fCavEX   /   SYSTEM ARCHITECTURE" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#B9DED5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="47" y="15" width="1230" height="28" as="geometry"/></mxCell><mxCell id="v4" value="From an applied edit to a durable save" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=40;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="46" y="43" width="1460" height="57" as="geometry"/></mxCell><mxCell id="v5" value="Wii A stages a complete checkpoint. A reboot selects one verified generation for both players." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontColor=#DDECEB;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="100" width="1500" height="29" as="geometry"/></mxCell><mxCell id="v6" value="A06  /  Commit a full generation on host storage" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#17313B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="49" y="167" width="1450" height="30" as="geometry"/></mxCell><mxCell id="live" value="&lt;div style=&quot;font-size:14px;color:#116B65;font-weight:bold;&quot;&gt;LIVE  /  TICK T&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Seal the snapshot&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Freeze a consistent view of chunks, both players, time, chest/sign data and action watermarks.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="49" y="229" width="310" height="154" as="geometry"/></mxCell><mxCell id="stage" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;STAGE  /  G+1&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Write new objects&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Write immutable region data and sidecars. Retain the previously committed files.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="434" y="229" width="315" height="154" as="geometry"/></mxCell><mxCell id="check" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;VERIFY  /  G+1&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Check every record&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Verify lengths, checksums and manifest references. Flush staged files under the selected storage contract.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="827" y="229" width="317" height="154" as="geometry"/></mxCell><mxCell id="mark" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;COMMIT  /  G+1&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Publish commit marker&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Use redundant checksummed markers. Report DURABLE(T) only after verifying the new complete generation.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="1218" y="229" width="332" height="154" as="geometry"/></mxCell><mxCell id="v10" value="Failure before a valid marker → retain G. Failure during marker publication → validate both markers and their referenced files. A column changed at T+1 stays dirty. Verify SD/FAT behavior on disposable media." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#A34538;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="62" y="403" width="1470" height="64" as="geometry"/></mxCell><mxCell id="v12" value="Reconnect without a second writer" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#17313B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="49" y="509" width="1450" height="30" as="geometry"/></mxCell><mxCell id="peer" value="&lt;div style=&quot;font-size:14px;color:#4C626C;font-weight:bold;&quot;&gt;PEER CONNECTION LOST&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Expire the peer session&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Neutralize B’s inputs, release its subscriptions and retain the player record. A can continue serving its local player.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="49" y="567" width="459" height="157" as="geometry"/></mxCell><mxCell id="host" value="&lt;div style=&quot;font-size:14px;color:#A34538;font-weight:bold;&quot;&gt;HOST STOPPED / RESTARTED&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Recover one verified generation&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Freeze the disconnected replica. A restarts with a new epoch, selects the newest valid manifest and loads its matching player records.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FBEDE9;strokeColor=#A34538;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="548" y="567" width="467" height="157" as="geometry"/></mxCell><object id="join" label="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;REJOIN  /  A03 · A06&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Resnapshot before accepting inputs&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Bind B to its saved identity; send recovered tick, action high-water and a fresh world base. Discard speculative old-epoch changes.&lt;/div&gt;" link="data:page/id,a-wire" tooltip="null"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="1055" y="567" width="495" height="157" as="geometry"/></mxCell></object><mxCell id="v15" value="One host owns the save. For the MVP, grant one host-owned chest lease at a time. Settle the cursor item and release the lease on disconnect. The MVP excludes persistent dropped entities." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="66" y="793" width="1470" height="59" as="geometry"/></mxCell><object id="v16" label="Fork · player + sidecar save" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_local.c#L403-L435" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="49" y="868" width="258" height="32" as="geometry"/></mxCell></object><object id="v17" label="Fork · dirty/evict path" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_world.c#L319-L344" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="324" y="868" width="252" height="32" as="geometry"/></mxCell></object><object id="v18" label="Fork · region update order" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/region_archive.c#L533-L543" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWid