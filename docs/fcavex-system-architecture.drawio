;br&gt;type · u8" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#285882;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="418" y="457" width="144" height="78" as="geometry"/></mxCell><mxCell id="field3" value="6–7&lt;br&gt;flags · u16" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#4C626C;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="566" y="457" width="167" height="78" as="geometry"/></mxCell><mxCell id="field4" value="8–11&lt;br&gt;payloadBytes · u32" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#285882;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="737" y="457" width="256" height="78" as="geometry"/></mxCell><mxCell id="field5" value="12–15&lt;br&gt;hostEpoch · u32" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#4C626C;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="997" y="457" width="217" height="78" as="geometry"/></mxCell><mxCell id="field6" value="16–19&lt;br&gt;senderSeq · u32" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#285882;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1218" y="457" width="204" height="78" as="geometry"/></mxCell><mxCell id="field7" value="20–23&lt;br&gt;tick · u32" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#4C626C;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1426" y="457" width="126" height="78" as="geometry"/></mxCell><mxCell id="v15" value="Read exactly one header, then exactly payloadBytes. TCP may split a header or combine several frames. Validate type, version and type-specific bounds before reserving memory. tick = 0 before assignment; HELLO uses epoch 0." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="547" width="1497" height="65" as="geometry"/></mxCell><object id="cmd" label="&lt;div style=&quot;font-size:14px;color:#116B65;font-weight:bold;&quot;&gt;INTENT → RESULT  /  A03 · A04&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Command + action ID&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;player bound to session; seq, action ID, target, expected revision. Result returns applied/rejected, tick and revision to that actor.&lt;/div&gt;" link="data:page/id,a-edit" tooltip="null"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="49" y="644" width="477" height="166" as="geometry"/></mxCell></object><object id="chunk" label="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;SNAPSHOT / DELTA  /  A03 · 