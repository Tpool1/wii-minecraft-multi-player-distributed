yle="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontColor=#DDECEB;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="100" width="1500" height="29" as="geometry"/></mxCell><mxCell id="v7" value="A08  /  TARGET SCHEDULE AT 59.94 Hz (ILLUSTRATIVE)" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="63" y="182" width="852" height="27" as="geometry"/></mxCell><mxCell id="v8" value="Host simulation" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#116B65;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="70" y="239" width="160" height="53" as="geometry"/></mxCell><mxCell id="v9" value="Display retraces" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#94561B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="70" y="306" width="160" height="53" as="geometry"/></mxCell><mxCell id="tick0" value="T+0" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="247" y="241" width="82" height="40" as="geometry"/></mxCell><mxCell id="v10" value="0 ms" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="234" y="373" width="111" height="30" as="geometry"/></mxCell><mxCell id="tick1" value="T+1" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="411" y="241" width="82" height="40" as="geometry"/></mxCell><mxCell id="v11" value="50 ms" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="398" y="373" width="111" height="30" as="geometry"/></mxCell><mxCell id="tick2" value="T+2" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="575" y="241" width="82" height="40" as="geometry"/></mxCell><mxCell id="v12" value="100 ms" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="562" y="373" width="111" height="30" as="geometry"/></mxCell><mxCell id="tick3" value="T+3" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=16;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="739" y="241" width="82" height="40" as="geometry"/></mxCell><mxCell id="v13" value="150 ms" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4C626C;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="726" y="373" width="111" height="30" as="geometry"/></mxCell><mxCell id="v26" value="Authority deadlines use a monotonic clock. The renderer presents a ready XFB at retrace; interpolation can draw between simulation ticks." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#4C626C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="72" y="412" width="820" height="61" as="geometry"/></mxCell><mxCell id="v28" value="PROPOSED GATES  /  A01 · A08" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="971" y="182" width="564" height="27" as="geometry"/></mxCell><mxCell id="tickG" value="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;HOST  /  20 UPDATES PER SECOND&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Tick work p95 ≤40 ms; p99 ≤50 ms&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Bound catch-up steps and track overruns, queued work, save stalls and per-actor fairness.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="978" y="232" width="550" height="107" as="geometry"/></mxCell><mxCell id="frG" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;EACH VIEW  /  REAL VI PRESENTATION&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Frame interval p95 ≤2 refreshes&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;p99 ≤3 refreshes. At 50 Hz two refreshes are 40 ms; at 59.94 Hz they are about 33.4 ms.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="978" y="357" width="550" height="110" as="geometry"/></mxCell><mxCell id="v29" value="Regional budget  /  charge allocations to the bank their addresses actually occupy" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#17313B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="521" width="1450" height="30" as="geometry"/></mxCell><mxCell id="m1" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;A08  /  PER CONSOLE&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;MEM1 · 24 MiB physical&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Bundled DOL spans 1.747 MiB of linked sections. Three 640×480 non-AA XFBs use about 1.76 MiB plus a 0.25 MiB GX FIFO. Mode and placement vary; retain ≥2 MiB free.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="48" y="572" width="466" height="211" as="geometry"/></mxCell><mxCell id="m2" value="&lt;div style=&quot;font-size:14px;color:#116B65;font-weight:bold;&quot;&gt;A08  /  ALLOCATION TARGETS&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;MEM2 · 64 MiB physical&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Radius-2 trial envelopes: A 23.75 MiB and B 16.25 MiB of assigned work. Budget runtime/IOS separately; retain ≥4 MiB free. Check the largest free block in each bank as well.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="545" y="572" width="481" height="211" as="geometry"/></mxCell><object id="work" label="&lt;div style=&quot;font-size:14px;color:#285882;font-weight:bold;&quot;&gt;A05 · A08  /  WORST CASE&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Disjoint interests + churning meshes&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;50 host columns × 82,176 B ≈3.92 MiB raw. One full local view adds ≈1.95 MiB of slabs. Baseline scanning 50 full columns visits 1,638,400 cells per update, ahead of callbacks.&lt;/div&gt;" link="data:page/id,a-chunk" tooltip="null"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="1055" y="572" width="496" height="211" as="geometry"/></mxCell></object><mxCell id="v30" value="On a real Wii, log bank high-water, largest free block, dirty pins, queue bytes, live display-list bytes and tick time by phase. If only the host fails at radius 2, rerun with a headless external authority." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="50" y="800" width="1495" height="60" as="geometry"/></mxCell><object id="v31" label="Fork · Wii sleep uses retraces" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/platform/thread.c#L129-L135" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="49" y="873" width="256" height="32" as="geometry"/></mxCell></object><object id="v32" label="Fork · server loop" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_local.c#L695-L702" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="321" y="873" width="223" height="32" as="geometry"/></mxCell></object><object id="v33" label="Fork · XFB allocation" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/platform/wii/gfx.c#L95-L107" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="558" y="873" width="239" height="32" as="geometry"/></mxCell></object><object id="v34" label="Fork · scan active cells" link="https://github.com/Tpool1/fCavEX/blob/7023e0e025ac5ad45e389755192e84392ee1b040/source/network/server_world.c#L392-L410" toolt