;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#94561B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="digB" target="v7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="751" y="519"/><mxPoint x="751" y="507"/></Array></mxGeometry></mxCell><mxCell id="e14" value="" style="html=1;rounded=0;edgeStyle=none;noEdgeStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#94561B;strokeWidth=2.4;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=15;fontFamily=Arial;fontColor=#94561B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="v7" target="display"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1276" y="403"/><mxPoint x="1276" y="398"/></Array></mxGeometry></mxCell><mxCell id="l15" style="endArrow=none;endFill=1;startArrow=none;strokeColor=#BDCED1;strokeWidth=1.5;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48" y="612" as="sourcePoint"/><mxPoint x="1550" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l21" style="endArrow=none;endFill=1;startArrow=none;strokeColor=#BDCED1;strokeWidth=1.5;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="925" as="sourcePoint"/><mxPoint x="1555" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v3" value="fCavEX   /   SYSTEM ARCHITECTURE" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=15;fontColor=#B9DED5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="47" y="15" width="1230" height="28" as="geometry"/></mxCell><mxCell id="v4" value="Two video feeds, one TV" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=40;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="46" y="43" width="1460" height="57" as="geometry"/></mxCell><mxCell id="v5" value="The display path starts after each Wii renders. No game packets carry video or audio." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontColor=#DDECEB;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="100" width="1500" height="29" as="geometry"/></mxCell><mxCell id="v6" value="A07  /  From each Wii’s AV port to its own TV viewport" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=21;fontColor=#17313B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="164" width="1450" height="30" as="geometry"/></mxCell><mxCell id="sigA" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;WII A  /  PHYSICAL&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;AV output A&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Video and stereo A&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="49" y="234" width="273" height="107" as="geometry"/></mxCell><mxCell id="sigB" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;WII B  /  PHYSICAL&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;AV output B&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Video and stereo B&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="49" y="464" width="273" height="107" as="geometry"/></mxCell><mxCell id="digA" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;CAPTURE CHANNEL 1&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Convert / capture A&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Match actual 480i, 576i or supported 480p mode.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="406" y="233" width="300" height="111" as="geometry"/></mxCell><mxCell id="digB" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;CAPTURE CHANNEL 2&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Convert / capture B&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Independent input and driver enumeration.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="406" y="463" width="300" height="111" as="geometry"/></mxCell><mxCell id="v8" value="CAPTURE COMPUTER  /  OBS" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4C626C;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="823" y="227" width="397" height="27" as="geometry"/></mxCell><mxCell id="panelA" value="View A&lt;br&gt;FIT / LEFT" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=#116B65;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=20;fontColor=#116B65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="836" y="281" width="174" height="142" as="geometry"/></mxCell><mxCell id="panelB" value="View B&lt;br&gt;FIT / RIGHT" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=#285882;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;align=center;spacingLeft=5;spacingRight=5;fontSize=20;fontColor=#285882;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1029" y="281" width="176" height="142" as="geometry"/></mxCell><mxCell id="v9" value="Match cadence and field order. Preserve display aspect. Monitor A stereo to the TV once; mute B and duplicate desktop audio." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="835" y="442" width="375" height="112" as="geometry"/></mxCell><mxCell id="display" value="&lt;div style=&quot;font-size:14px;color:#94561B;font-weight:bold;&quot;&gt;FULLSCREEN PROJECTOR&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;TV display&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;One composed output + selected audio.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=#94561B;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="1322" y="336" width="227" height="124" as="geometry"/></mxCell><mxCell id="gear" value="&lt;div style=&quot;font-size:14px;color:#4C626C;font-weight:bold;&quot;&gt;COMPATIBILITY  /  CHECK LABELS&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Console, capture and TV&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Confirm homebrew boot, LAN, cables, region, both capture channels and TV mode. RVL-201 mini lacks supported networking and SD; RVL-101 lacks GC controller ports.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="48" y="648" width="477" height="168" as="geometry"/></mxCell><mxCell id="opt" value="&lt;div style=&quot;font-size:14px;color:#4C626C;font-weight:bold;&quot;&gt;ALTERNATE COMPOSITOR&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Hardware picture-by-picture&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;A verified multiviewer may replace both capture paths and OBS if it accepts both converted timings, chooses A audio and meets the latency gate.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F3F6F6;strokeColor=#4C626C;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="553" y="648" width="459" height="168" as="geometry"/></mxCell><mxCell id="measure" value="&lt;div style=&quot;font-size:14px;color:#655182;font-weight:bold;&quot;&gt;PHYSICAL ACCEPTANCE  /  H03 · H04&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#17313B;font-weight:bold;&quot;&gt;Separate three measurements&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#4C626C;&quot;&gt;Film input→TV directly and via composition. Split one numbered source to isolate path skew. Then film a shared game-event ID to measure network + presentation skew.&lt;/div&gt;" style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#F2EEF7;strokeColor=#655182;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;spacingLeft=15;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="1043" y="648" width="507" height="168" as="geometry"/></mxCell><mxCell id="v16" value="1920×1080 example: fit one 4:3 image at 960×720 in each half. Calibrate each Wii’s pointer to its displayed viewport and test the HUD at the actual seating distance." style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=17;fontColor=#17313B;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1"><mxGeometry x="51" y="829" width="1485" height="40" as="geometry"/></mxCell><object id="v17" label="Nintendo · Wii model guide" link="https://en-americas-support.nintendo.com/app/answers/detail/a_id/2650" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="48" y="879" width="250" height="32" as="geometry"/></mxCell></object><object id="v18" label="OBS · capture source" link="https://obsproject.com/kb/video-capture-sources" tooltip="Open the referenced source"><mxCell style="fontFamily=Arial;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#BDCED1;strokeWidth=1.5;rounded=1;arcSize=9;spacing=0;fontSize=14;fontColor=#285882;align=center;spacing=0;" parent="1" vertex="1"><mxGeometry x="315" y="879" width="245" height="32" as="geometry"/></mxCell></object><object id="v19" label="OBS · scene projector" link="https://obsproject.com/kb/power-of-projectors" tooltip="Open the referenced source"><mxCell style="fontFamily