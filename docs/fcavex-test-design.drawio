ry"/></mxCell><mxCell id="t-unit-io-v28" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#EAF2F9;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="228" y="415" width="160" height="120" as="geometry"/></mxCell><mxCell id="t-unit-io-v29" value="A  ·  LEFT" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="69" y="434" width="157" height="37" as="geometry"/></mxCell><mxCell id="t-unit-io-v30" value="B  ·  RIGHT" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="229" y="434" width="157" height="37" as="geometry"/></mxCell><mxCell id="t-unit-io-v31" value="audio gain 1" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="69" y="476" width="157" height="28" as="geometry"/></mxCell><mxCell id="t-unit-io-v32" value="audio gain 0" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="229" y="476" width="157" height="28" as="geometry"/></mxCell><mxCell id="t-unit-io-v33" value="Inject a mock source catalog, output dimensions and an audio-route collector. Feed numbered IDs A and B; re-enumerate B under the same stable ID." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="410" y="385" width="351" height="168" as="geometry"/></mxCell><mxCell id="t-unit-io-v34" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="68" y="567" width="699" height="1" as="geometry"/></mxCell><mxCell id="t-unit-io-v35" value="Assert geometry and routes" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="590" width="699" height="29" as="geometry"/></mxCell><mxCell id="t-unit-io-v36" value="A rect = (0,180,960,720); B rect = (960,180,960,720). Preserve 4:3, never crop either edge. Exact gain snapshot has one A→TV route and zero audible B routes." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="68" y="631" width="696" height="112" as="geometry"/></mxCell><mxCell id="t-unit-io-v37" value="Inject one-source loss" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="761" width="699" height="31" as="geometry"/></mxCell><mxCell id="t-unit-io-v38" value="Mark B absent, then restore it. A keeps its assigned cell and route; B returns to the right cell. Verify advancing feeds, audible output and recovery time in H03." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="68" y="805" width="696" height="89" as="geometry"/></mxCell><mxCell id="t-unit-io-v39" value="Fixture  ·  Monotonic clock and synthetic free lists" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="833" y="347" width="694" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v40" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FEF4E6;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="833" y="393" width="148" height="78" as="geometry"/></mxCell><mxCell id="t-unit-io-v41" value="0 ms" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="833" y="400" width="148" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v42" value="0 steps" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="833" y="436" width="148" height="24" as="geometry"/></mxCell><mxCell id="t-unit-io-v43" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="981" y="432" as="sourcePoint"/><mxPoint x="1000" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-io-v44" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FEF4E6;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1001" y="393" width="148" height="78" as="geometry"/></mxCell><mxCell id="t-unit-io-v45" value="49 ms" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1001" y="400" width="148" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v46" value="0 steps" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1001" y="436" width="148" height="24" as="geometry"/></mxCell><mxCell id="t-unit-io-v47" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1149" y="432" as="sourcePoint"/><mxPoint x="1168" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-io-v48" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FEF4E6;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1169" y="393" width="148" height="78" as="geometry"/></mxCell><mxCell id="t-unit-io-v49" value="50 ms" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1169" y="400" width="148" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v50" value="1 step" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1169" y="436" width="148" height="24" as="geometry"/></mxCell><mxCell id="t-unit-io-v51" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1317" y="432" as="sourcePoint"/><mxPoint x="1336" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-io-v52" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FEF4E6;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1337" y="393" width="148" height="78" as="geometry"/></mxCell><mxCell id="t-unit-io-v53" value="100 ms" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1337" y="400" width="148" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v54" value="1 step" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1337" y="436" width="148" height="24" as="geometry"/></mxCell><mxCell id="t-unit-io-v55" value="Start the fixed 20 Hz scheduler at zero. Step through these timestamps. With catch-up capped at two, a 250 ms jump makes five steps due. Assert two executed and debt + missed = three at the end of this pump." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="833" y="493" width="687" height="88" as="geometry"/></mxCell><mxCell id="t-unit-io-v56" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="833" y="596" width="699" height="1" as="geometry"/></mxCell><mxCell id="t-unit-io-v57" value="Check bank identity, high-water and fragmentation" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="833" y="617" width="690" height="30" as="geometry"/></mxCell><mxCell id="t-unit-io-v58" value="Fake MEM1/MEM2 ranges. Allocate 128 KiB in MEM2, grow in place to 192 KiB, then free. Assert MEM2 current = 0, peak = 192 KiB and no MEM1 charge. Failed allocation leaves live totals intact." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="833" y="660" width="685" height="111" as="geometry"/></mxCell><mxCell id="t-unit-io-v59" value="Set free total = 6 MiB, largest span = 384 KiB, next request = 256 KiB. The 2× contiguous-headroom check must fail. H02 records real spans and sampled peaks." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="833" y="787" width="687" height="105" as="geometry"/></mxCell><mxCell id="t-unit-io-v60" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-unit-io-v61" value="A07 policy results can be unit-tested without OBS. A08 fake-time results do not certify the physical host tick rate." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="959" width="1260" height="25" as="geometry"/></mxCell><mxCell id="t-unit-io-v62" value="TEST DESIGN  /  04 OF 07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1302" y="959" width="250" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="t-integration" name="Integration"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-integration-v1" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="1000" as="geometry"/></mxCell><mxCell id="t-integration-v2" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#655182;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="7" as="geometry"/></mxCell><mxCell id="t-integration-v3" value="fCavEX  /  TWO-CONSOLE VERIFICATION" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="19" width="880" height="23" as="geometry"/></mxCell><UserObject id="t-integration-v4" label="Companion file  ·  fcavex-system-architecture.drawio" link="fcavex-system-architecture.drawio"><mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="868" y="19" width="684" height="23" as="geometry"/></mxCell></UserObject><mxCell id="t-integration-v5" value="Integration tests across two game instances" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=42;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="48" width="1510" height="54" as="geometry"/></mxCell><mxCell id="t-integration-v6" value="Use A as authority and B as client. Repeat the same commands through A’s local adapter and B’s real stream. All four scenarios are planned." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="106" width="1504" height="30" as="geometry"/></mxCell><UserObject id="t-integration-v7" label="Verification map" link="data:page/id,t-overview"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="205" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v8" label="Client units" link="data:page/id,t-unit-client"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="262" y="150" width="175" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v9" label="Authority units" link="data:page/id,t-unit-host"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="446" y="150" width="203" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v10" label="I/O &amp; budgets" link="data:page/id,t-unit-io"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="658" y="150" width="193" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v11" label="Integration" link="data:page/id,t-integration"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#655182;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="170" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v12" label="Hardware" link="data:page/id,t-hardware"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="1039" y="150" width="150" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-integration-v13" label="Evidence" link="data:page/id,t-evidence"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="1198" y="150" width="147" height="37" as="geometry"/></mxCell></UserObject><mxCell id="t-integration-v14" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="201" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-integration-v15" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#EAF2F9;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="222" width="1504" height="68" as="geometry"/></mxCell><mxCell id="t-integration-v16" value="Fixture F1     Copy a self-authored Beta-format strip, x = −20…19 and z = −5…5. Mark boundaries, empty/dense/checkerboard columns, a chest, a sign and two distinct inventories. Record seed or archive SHA-256; begin with empty peer storage." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#285882;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="64" y="231" width="1470" height="49" as="geometry"/></mxCell><mxCell id="t-integration-v17" value="SCENARIO / TRACE" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="307" width="210" height="28" as="geometry"/></mxCell><mxCell id="t-integration-v18" value="SET UP AND DRIVE" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="291" y="307" width="383" height="28" as="geometry"/></mxCell><mxCell id="t-integration-v19" value="FAULT OR VARIATION" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="696" y="307" width="396" height="28" as="geometry"/></mxCell><mxCell id="t-integration-v20" value="GO / NO-GO ORACLE" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1111" y="307" width="424" height="28" as="geometry"/></mxCell><mxCell id="t-integration-v21" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="344" width="1504" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v22" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="344" width="5" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v23" value="I01" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="356" width="67" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v24" value="World agreement" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="392" width="217" height="57" as="geometry"/></mxCell><mxCell id="t-integration-v25" value="A01 · A02 · A03 · A04" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="453" width="216" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v26" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="280" y="356" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v27" value="Join on F1; move B while A stands still. Run 50 place pairs and 50 break pairs at one cell. Reset the precondition for each pair." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="291" y="356" width="383" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v28" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="685" y="356" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v29" value="Same apply tick: reverse arrival. Different ticks: earlier tick wins. Replay the losing ID; try stale version/world, invalid reach and empty inventory." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="696" y="356" width="396" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v30" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1100" y="356" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v31" value="One winner, one inventory effect, same final revision and player records. Rejects leave state intact. Independent camera/HUD and equal ready-column digests after drain." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1111" y="356" width="424" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v32" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#F5F8F8;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="495" width="1504" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v33" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="495" width="5" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v34" value="I02" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="507" width="67" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v35" value="Split and reunite" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="543" width="217" height="57" as="geometry"/></mxCell><mxCell id="t-integration-v36" value="A02 · A05 · A08" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="604" width="216" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v37" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="280" y="507" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v38" value="At radius 2, walk ±12 columns, settle, edit at both ends, exchange positions and meet again. Repeat three cycles." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="291" y="507" width="383" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v39" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="685" y="507" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v40" value="Delay the far-side snapshot; change direction mid-load. Remove one required column. Include dirty pins, in-flight buffers and dense rebuilds in the ledger." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="696" y="507" width="396" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v41" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1100" y="507" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v42" value="At rest all present fixture columns are ready within 5 s. Absent terrain blocks entry. Hashes match at equal revision, edits survive the swap, active union measures 25→50→25." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1111" y="507" width="424" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v43" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="646" width="1504" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v44" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="646" width="5" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v45" value="I03" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="658" width="67" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v46" value="Save and rejoin" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="694" width="217" height="57" as="geometry"/></mxCell><mxCell id="t-integration-v47" value="A02 · A03 · A06" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="755" width="216" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v48" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="280" y="658" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v49" value="Stage block/chest/sign edits; log player poses, inventory, time and action IDs. Checkpoint, drop B, move A and reconnect B; restart A. Repeat 10×." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="291" y="658" width="383" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v50" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="685" y="658" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v51" value="Fail chunk, metadata and commit-marker writes on disposable copies. Stop before/after commit. Try a stale epoch, wrong identity and repeated durable action." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="696" y="658" width="396" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v52" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1100" y="658" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v53" value="Recover one whole checksummed generation; durable work survives once. Two stable roles, peer writes no world. On host loss B freezes; on return discard predictions and resnapshot." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1111" y="658" width="424" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v54" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#F5F8F8;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="797" width="1504" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v55" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="797" width="5" height="143" as="geometry"/></mxCell><mxCell id="t-integration-v56" value="I04" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="809" width="67" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v57" value="Backpressure and loss" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="845" width="217" height="57" as="geometry"/></mxCell><mxCell id="t-integration-v58" value="A03 · A04 · A05 · A08" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="906" width="216" height="26" as="geometry"/></mxCell><mxCell id="t-integration-v59" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="280" y="809" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v60" value="G1: 200 numbered 32-byte payloads per direction; 3 reconnects. Run each 5 min profile: nominal, +50/+100 ms one way, ±20 ms jitter, 2 s stall." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="291" y="809" width="383" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v61" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="685" y="809" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v62" value="Before enqueue, interleave chunks/control. Disconnect B 10 s and reconnect 10×. Separately test actual 1%/5% packet loss on an isolated lab link; keep TCP byte order." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="696" y="809" width="396" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v63" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1100" y="809" width="1" height="118" as="geometry"/></mxCell><mxCell id="t-integration-v64" value="Bound all queued bytes; no stale work applies. Detect loss ≤5 s at 1 s heartbeats. On clean rejoin restore ready snapshot ≤5 s. Check stable hashes and p95 edit→peer ≤100 ms." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1111" y="809" width="424" height="124" as="geometry"/></mxCell><mxCell id="t-integration-v65" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-integration-v66" value="Hash only ready shared columns at the same revision. Serialize coordinates, block/data/light and height in fixed order; hash sorted player and sidecar records separately." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="959" width="1260" height="25" as="geometry"/></mxCell><mxCell id="t-integration-v67" value="TEST DESIGN  /  05 OF 07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1302" y="959" width="250" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="t-hardware" name="Hardware"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-hardware-v1" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="1000" as="geometry"/></mxCell><mxCell id="t-hardware-v2" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#655182;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="7" as="geometry"/></mxCell><mxCell id="t-hardware-v3" value="fCavEX  /  TWO-CONSOLE VERIFICATION" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="19" width="880" height="23" as="geometry"/></mxCell><UserObject id="t-hardware-v4" label="Companion file  ·  fcavex-system-architecture.drawio" link="fcavex-system-architecture.drawio"><mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="868" y="19" width="684" height="23" as="geometry"/></mxCell></UserObject><mxCell id="t-hardware-v5" value="Hardware acceptance on two physical Wiis" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=42;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="48" width="1510" height="54" as="geometry"/></mxCell><mxCell id="t-hardware-v6" value="Record model, firmware, homebrew build, controller pairing, local IP, signal mode and TV path. A and B must use their own controls and one camera each." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="106" width="1504" height="30" as="geometry"/></mxCell><UserObject id="t-hardware-v7" label="Verification map" link="data:page/id,t-overview"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="205" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v8" label="Client units" link="data:page/id,t-unit-client"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="262" y="150" width="175" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v9" label="Authority units" link="data:page/id,t-unit-host"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="446" y="150" width="203" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v10" label="I/O &amp; budgets" link="data:page/id,t-unit-io"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="658" y="150" width="193" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v11" label="Integration" link="data:page/id,t-integration"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="170" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v12" label="Hardware" link="data:page/id,t-hardware"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#655182;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="1039" y="150" width="150" height="37" as="geometry"/></mxCell></UserObject><UserObject id="t-hardware-v13" label="Evidence" link="data:page/id,t-evidence"><mxCell style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F5F8F8;strokeColor=none;fontColor=#42616B;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="1198" y="150" width="147" height="37" as="geometry"/></mxCell></UserObject><mxCell id="t-hardware-v14" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="201" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v15" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="222" width="742" height="313" as="geometry"/></mxCell><mxCell id="t-hardware-v16" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#116B65;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="222" width="742" height="6" as="geometry"/></mxCell><mxCell id="t-hardware-v17" value="H01" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=none;fontColor=#116B65;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="63" y="240" width="71" height="28" as="geometry"/></mxCell><mxCell id="t-hardware-v18" value="LAN and player controls" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="147" y="232" width="618" height="45" as="geometry"/></mxCell><mxCell id="t-hardware-v19" value="A01 · A02 · A03" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="278" width="711" height="23" as="geometry"/></mxCell><mxCell id="t-hardware-v20" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="306" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v21" value="Setup" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="312" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v22" value="Two LAN/SD-capable Wiis, one disposable SD copy each, existing private LAN and two paired Remotes/Nunchuks. Confirm model, boot and network support before timing." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="311" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v23" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="379" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v24" value="Drive" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="385" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v25" value="Run the 200 × 32-byte G1 exchange in both directions with 3 reconnects. Move A alone, B alone and both; aim each pointer at four viewport corners." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="384" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v26" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="452" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v27" value="Accept" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="458" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v28" value="Every nonce, sequence and payload matches. Each controller acts only on its own avatar/camera; both can move together. Retain endpoint logs and a filmed control trace." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="457" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v29" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="810" y="222" width="742" height="313" as="geometry"/></mxCell><mxCell id="t-hardware-v30" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#A36224;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="810" y="222" width="742" height="6" as="geometry"/></mxCell><mxCell id="t-hardware-v31" value="H02" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=none;fontColor=#A36224;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="825" y="240" width="71" height="28" as="geometry"/></mxCell><mxCell id="t-hardware-v32" value="Per-bank memory and pacing" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="909" y="232" width="618" height="45" as="geometry"/></mxCell><mxCell id="t-hardware-v33" value="A04 · A05 · A06 · A08" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="826" y="278" width="711" height="23" as="geometry"/></mxCell><mxCell id="t-hardware-v34" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="306" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v35" value="Setup" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="312" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v36" value="Retail memory; tag pointer ranges, current/peak, largest free span and next allocation. Record tick work and actual VI presents; test each physical Wii in both roles." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="311" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v37" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="379" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v38" value="Drive" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="385" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v39" value="At r=2 run 60 min, then 4 h. Every 5 min cross dense terrain, separate, edit, checkpoint and rejoin. Swap roles for a further 60 min. Log events and 1 s samples." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="384" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v40" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="452" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v41" value="Accept" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="458" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v42" value="MEM1 ≥2 MiB and MEM2 ≥4 MiB free; largest span ≥2× next required block. Final-hour matched-state growth ≤256 KiB/bank. Zero failed allocs/resets. See timing strip below." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="457" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v43" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="545" width="742" height="313" as="geometry"/></mxCell><mxCell id="t-hardware-v44" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#A36224;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="545" width="742" height="6" as="geometry"/></mxCell><mxCell id="t-hardware-v45" value="H03" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FEF4E6;strokeColor=none;fontColor=#A36224;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="63" y="563" width="71" height="28" as="geometry"/></mxCell><mxCell id="t-hardware-v46" value="Feed recovery and audio" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="147" y="555" width="618" height="45" as="geometry"/></mxCell><mxCell id="t-hardware-v47" value="A07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="601" width="711" height="23" as="geometry"/></mxCell><mxCell id="t-hardware-v48" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="629" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v49" value="Setup" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="635" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v50" value="Two independent capture paths into one local scene or verified multiviewer. Note field order, aspect, measured cadence, buffering and TV mode. Use distinct numbered flashes/clicks." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="634" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v51" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="702" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v52" value="Drive" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="708" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v53" value="Run 60 min. Reset A, B and both, three cycles per case. Start recovery clock when valid video returns. Compare frames, unaffected feed, audio route and drift." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="707" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v54" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="63" y="775" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v55" value="Accept" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63" y="781" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v56" value="Correct cells/aspects; both recover ≤5 s. Other view keeps advancing. A click once, B silent; |A flash–click offset| ≤50 ms. Save TV recording and scene/device map." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="780" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v57" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="810" y="545" width="742" height="313" as="geometry"/></mxCell><mxCell id="t-hardware-v58" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="810" y="545" width="742" height="6" as="geometry"/></mxCell><mxCell id="t-hardware-v59" value="H04" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="825" y="563" width="71" height="28" as="geometry"/></mxCell><mxCell id="t-hardware-v60" value="Input latency and view skew" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="909" y="555" width="618" height="45" as="geometry"/></mxCell><mxCell id="t-hardware-v61" value="A01 · A07 · A08" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="826" y="601" width="711" height="23" as="geometry"/></mxCell><mxCell id="t-hardware-v62" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="629" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v63" value="Setup" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="635" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v64" value="Film ≥240 fps at equal screen height. Use electrical closure indicator or label visible travel as a surrogate. Fix TV mode, scene, controller and control order." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="634" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v65" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="702" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v66" value="Drive" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="708" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v67" value="100 presses/player direct, then 100/player composed. Split one numbered flash into both paths for capture skew. Film the same event ID on both Wiis. Lag (ms) = frame difference × 1000 / camera fps." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="707" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v68" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="825" y="775" width="710" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v69" value="Accept" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="781" width="71" height="27" as="geometry"/></mxCell><mxCell id="t-hardware-v70" value="Per path p95 ≤100 ms; composed minus direct p95 ≤2 refreshes. Split-flash |skew| p95 ≤1 refresh, max ≤2. Shared-event p95 ≤100 ms. Report median/p95/max and frame uncertainty." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900" y="780" width="637" height="68" as="geometry"/></mxCell><mxCell id="t-hardware-v71" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FEF4E6;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="879" width="1504" height="54" as="geometry"/></mxCell><mxCell id="t-hardware-v72" value="H02 timing     Target 20 Hz. Clean tick work p95 ≤40 ms, p99 ≤50 ms. Each VI present interval p95 ≤2 refreshes and p99 ≤3. Record maximum stalls and missed deadlines." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="886" width="1470" height="38" as="geometry"/></mxCell><mxCell id="t-hardware-v73" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-hardware-v74" value="If Wii A alone misses r=2 limits, compare an external authority on the same fixture. If B also misses, inspect client decode, mesh and presentation first." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="959" width="1260" height="25" as="geometry"/></mxCell><mxCell id="t-hardware-v75" value="TEST DESIGN  /  06 OF 07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1302" y="959" width="250" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram>
