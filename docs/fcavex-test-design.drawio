"" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1101" y="297" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-host-v28" value="World at tick 120" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="262" width="340" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v29" value="Two players can reach empty block (0,65,0), rev 17. A and B each own one block. Stub reach, inventory, tick and outbound event sink." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="332" y="301" width="340" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v30" value="Permute deliveries" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="262" width="386" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v31" value="Same apply tick: present B#9 before A#4, then reverse arrival on a fresh fixture. Replay winner and loser IDs. Repeat with stale revision and out-of-reach target." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="301" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v32" value="Authoritative delta" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="262" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v33" value="Slot A wins either order; revision becomes 18 and A alone spends one. Replays change no inventory, drop or revision. Invalid edits have zero side effects." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="301" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v34" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="278" as="sourcePoint"/><mxPoint x="679" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-host-v35" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1068" y="278" as="sourcePoint"/><mxPoint x="1094" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-host-v36" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="478" wid