<diagram id="t-unit-client" name="Client units"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-unit-client-v1" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="1000" as="geometry"/></mxCell><mxCell id="t-unit-client-v2" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#655182;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="7" as="geometry"/></mxCell><mxCell id="t-unit-client-v3" value="fCavEX  /  TWO-CONSOLE VERIFICATION" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="19" width="880" height="23" as="geometry"/></mxCell><UserObject id="t-unit-client-v4" label="Companion file  ·  fcavex-system-architecture.drawio" link="fcavex-system-architecture.drawio"><mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#285882;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="868" y="19" width="684" height="23" as="geometry"/></mxCell></UserObject><mxCell id="t-unit-client-v5" value="Client and protocol unit tests" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalA