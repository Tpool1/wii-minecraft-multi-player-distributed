ng=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="395" width="750" height="25" as="geometry"/></mxCell><mxCell id="t-evidence-v21" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#E7F4EF;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="437" width="782" height="148" as="geometry"/></mxCell><mxCell id="t-evidence-v22" value="E02" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#116B65;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="64" y="449" width="68" height="29" as="geometry"/></mxCell><mxCell id="t-evidence-v23" value="Independent emulated input" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="444" width="667" height="40" as="geometry"/></mxCell><mxCell id="t-evidence-v24" value="A timed B-button pulse on A’s emulated Wii Remote advanced its menu. B stayed at the startup prompt. Focused F/G taps gave no visible confirmation. Physical inputs remain open." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="64" y="492" width="745" height="64" as="geometry"/></mxCell><mxCell id="t-evidence-v25" value="evidence/input-paired-frames.json  ·  A-after.png  ·  B-control.png" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="555" width="750" height="25" as="geometry"/></mxCell><mxCell id="t-evidence-v26" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#E7F4EF;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="597" width="782" height="148" as="geometry"/></mxCell><mxCell id="t-evidence-v27" value="E03" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#116B65;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="64" y="609" width="68" height="29" as="geometry"/></mxCell><mxCell id="t-evidence-v28" value="Guest TCP on loopback" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="604" width="667" height="40" as="geometry"/></mxCell><mxCell id="t-evidence-v29" value="Two asset-free Wii ELFs on 127.0.0.1 exchanged Q, R and K, 16 bytes each. Both guests logged PASS for nonce dd417885. Port 45837 was loopback-only. Full G1, private LAN and game replication remain open." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="64" y="652" width="745" height="64" as="geometry"/></mxCell><mxCell id="t-evidence-v30" value="loopback/Evidence-20261121-164214Z/guest-exchange.txt" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=n