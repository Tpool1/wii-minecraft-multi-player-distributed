><mxCell id="t-unit-host-v48" value="Move centers to x = −12 and +12. Delay B’s fragment, evict an old interest, then deliver its stale generation. Remove a required store column." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="525" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v49" value="Coverage &amp; bounds" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="486" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v50" value="Active host union grows 25 → 50; each ready client has 25. Tick shared columns once. Stale work stays retired. Missing column blocks entry and never appears ready." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="525" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v51" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="502" as="sourcePoint"/><mxPoint x="679" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-host-v52" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColo