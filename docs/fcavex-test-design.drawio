=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="216" width="250" height="26" as="geometry"/></mxCell><mxCell id="t-unit-client-v16" value="CONTROLLED FIXTURE" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="216" width="340" height="26" as="geometry"/></mxCell><mxCell id="t-unit-client-v17" value="INJECT OR EXECUTE" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="216" width="386" height="26" as="geometry"/></mxCell><mxCell id="t-unit-client-v18" value="EXPECTED OBSERVATION" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="216" width="418" height="26" as="geometry"/></mxCell><mxCell id="t-unit-client-v19" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="254" width="1504" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v20" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#116B65;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="254" width="6" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v21" value="U01" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=none;fontColor=#116B65;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="268" width="78" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v22" value="A01" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="155" y="268" width="150" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v23" value="Local controls and camera" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="312" width="247" height="68" as="geometry"/></mxCell><mxCell id="t-unit-client-v24" value="Architecture  ·  a-runtime" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="391" width="247" height="54" as="geometry"/></mxCell><mxCell id="t-unit-client-v25" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="316" y="297" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v26" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="686" y="297" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v27" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1101" y="297" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v28" value="Input script" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="262" width="340" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v29" value="Two isolated clients; fake WPAD, clock and GX call recorder. A starts at yaw 0°, B at 90°. One camera per client." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="332" y="301" width="340" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v30" value="Frame step" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="262" width="386" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v31" value="At tick 7 feed B a +15° look intent. Render A and B once. Release B’s controls, then open only B’s menu." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="301" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v32" value="View recorder" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="262" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v33" value="A remains at 0°, B reaches 105°. One camera/pass per client; no second viewport. Empty input adds zero rotation. A still ticks while B’s menu is open." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="301" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v34" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="278" as="sourcePoint"/><mxPoint x="679" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v35" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1068" y="278" as="sourcePoint"/><mxPoint x="1094" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v36" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="478" width="1504" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v37" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#116B65;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="478" width="6" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v38" value="U02" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E7F4EF;strokeColor=none;fontColor=#116B65;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="492" width="78" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v39" value="A02" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="155" y="492" width="150" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v40" value="Client replica and local adapter" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="536" width="247" height="68" as="geometry"/></mxCell><mxCell id="t-unit-client-v41" value="Architecture  ·  a-runtime / a-wire" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="615" width="247" height="54" as="geometry"/></mxCell><mxCell id="t-unit-client-v42" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="316" y="521" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v43" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="686" y="521" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v44" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1101" y="521" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v45" value="State fixture" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="486" width="340" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v46" value="Start one replica at column (0,0), rev 7. Use a fake transport, fake mesher and mutable source buffer. Save a canonical baseline hash." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="332" y="525" width="340" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v47" value="Adapter + replica" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="486" width="386" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v48" value="Run the same owned edit/result through local and encoded loopback adapters. Overwrite the sender buffer. Deliver rev 8 twice, then rev 10 with rev 9 missing." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="525" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v49" value="Value &amp; revision checks" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#116B65;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="486" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v50" value="Both produce equal state at rev 8 and one rebuild. Sender reuse changes nothing. Gap triggers one resnapshot request; rev 10 cannot overwrite the missing history." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="525" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v51" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="502" as="sourcePoint"/><mxPoint x="679" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v52" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1068" y="502" as="sourcePoint"/><mxPoint x="1094" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v53" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#FFFFFF;strokeColor=#C8D8DC;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="702" width="1504" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v54" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#285882;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="702" width="6" height="208" as="geometry"/></mxCell><mxCell id="t-unit-client-v55" value="U03" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2F9;strokeColor=none;fontColor=#285882;fontFamily=Arial;fontStyle=1;fontSize=17;spacing=1;" vertex="1" parent="1"><mxGeometry x="65" y="716" width="78" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v56" value="A03" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="155" y="716" width="150" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v57" value="Session and wire codec" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#17313B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="760" width="247" height="68" as="geometry"/></mxCell><mxCell id="t-unit-client-v58" value="Architecture  ·  a-wire" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="839" width="247" height="54" as="geometry"/></mxCell><mxCell id="t-unit-client-v59" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="316" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v60" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="686" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v61" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1101" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-client-v62" value="Golden bytes" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="710" width="340" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v63" value="Golden 24-byte header: epoch 0x01020304 at bytes 12–15, tick 9 at 20–23. Mock a short-reading TCP stream, bounded allocator and decoded-message sink." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="332" y="749" width="340" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v64" value="Stream slicer" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="710" width="386" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v65" value="Split at every header byte; combine two frames in one read. Try cap+1 declared length, 8193-byte chunk data (cap 8192), wrong version/world, stale epoch and EOF mid-payload." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="749" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v66" value="Parser and session" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#285882;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="710" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-client-v67" value="Every valid split emits one identical owned value; combined read emits two. Reject invalid input before mutation or oversized allocation. No gameplay before HELLO succeeds." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="749" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-client-v68" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="726" as="sourcePoint"/><mxPoint x="679" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v69" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1068" y="726" as="sourcePoint"/><mxPoint x="1094" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-client-v70" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-unit-client-v71" value="Unit runs are proposed. Record the input script, full golden vector, codec version, actual result and first mismatching field." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="959" width="1260" height="25" as="geometry"/></mxCell><mxCell id="t-unit-client-v72" value="TEST DESIGN  /  02 OF 07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1302" y="959" width="250" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram>
