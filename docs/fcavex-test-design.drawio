=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="839" width="247" height="54" as="geometry"/></mxCell><mxCell id="t-unit-host-v59" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="316" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-host-v60" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="686" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-host-v61" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1101" y="745" width="1" height="149" as="geometry"/></mxCell><mxCell id="t-unit-host-v62" value="Copy-on-write store" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="710" width="340" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v63" value="In-memory file system, write-failure switch and commit marker. Generation 7 has known world, player inventories, chest, sign and action ledger. Stage generation 8." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="332" y="749" width="340" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v64" value="Fail at commit boundaries" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="701" y="710" width="386" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v65" value="Fail data write, manifest or marker separately. Restart before and after publication, then replay a recorded durable action. Count writes attempted by B." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="701" y="749" width="386" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v66" value="Recovered generation" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#A36224;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1116" y="710" width="418" height="29" as="geometry"/></mxCell><mxCell id="t-unit-host-v67" value="Before publication recover generation 7 intact; after verified publication recover 8. No mixed records; failed pages stay dirty, durable retry cannot charge twice, B writes zero checkpoints." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#17313B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1116" y="749" width="418" height="151" as="geometry"/></mxCell><mxCell id="t-unit-host-v68" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="726" as="sourcePoint"/><mxPoint x="679" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-host-v69" style="edgeStyle=none;rounded=0;html=0;startArrow=none;endArrow=block;endFill=1;endSize=8;strokeColor=#C8D8DC;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1068" y="726" as="sourcePoint"/><mxPoint x="1094" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-unit-host-v70" value="" style="shape=rectangle;rounded=0;html=0;fillColor=#C8D8DC;strokeColor=none;strokeWidth=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1504" height="1" as="geometry"/></mxCell><mxCell id="t-unit-host-v71" value="Each unit starts from a fresh fixture. Persist the command order, column generations and injected write boundary with the verdict." style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#42616B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48" y="959" width="1260" height="25" as="geometry"/></mxCell><mxCell id="t-unit-host-v72" value="TEST DESIGN  /  03 OF 07" style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;labelPadding=0;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#655182;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1302" y="959" width="250" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram>
